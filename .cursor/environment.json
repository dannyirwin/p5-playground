{
  "name": "p5-playground",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "install": "npm install && npx --yes skills experimental_install",
  "terminals": [
    {
      "name": "dev",
      "command": "npm run dev",
      "description": "SvelteKit Vite dev server on port 5173"
    }
  ],
  "ports": [
    {
      "name": "dev",
      "port": 5173
    }
  ]
}
